{
  "name": "arc-ledger-match",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts *.mjs",
    "build": "tsc && node scripts/build.mjs",
    "test": "npm run build && node --test tests/domain.test.mjs tests/arc.test.mjs tests/deployment.test.mjs tests/presentation.test.mjs",
    "start": "node scripts/serve.mjs",
    "dev": "npm run build && npm start",
    "test:ui": "playwright test",
    "validate": "npm run lint && npm run typecheck && npm test",
    "smoke:rpc": "npm run build && node scripts/live-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
